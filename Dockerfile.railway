# =============================================================================
# Dockerfile.railway — backend image for cloud deploy (build from the REPO ROOT)
#   docker build -f Dockerfile.railway -t hh-backend .
# Self-contained: the knowledge base (outside backend/ in dev, where compose
# mounts it) is baked into the image so RAG ingest works on any host.
# =============================================================================
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libmupdf-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

FROM base AS builder
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY backend/pyproject.toml ./
RUN pip install -e ".[dev]"

FROM base AS production
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/bash --create-home appuser

ENV PATH="/opt/venv/bin:$PATH"
COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=appuser:appgroup backend/ ./
COPY --chown=appuser:appgroup knowledge_base/ /app/knowledge_base

USER appuser
EXPOSE 8000

# Railway uses this CMD as the start command. Migrations run on every boot;
# seed_db.py is deliberately NOT here — it TRUNCATEs every table, so seeding and
# knowledge-base ingest are one-shot steps run manually in the shell.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips '*'"]

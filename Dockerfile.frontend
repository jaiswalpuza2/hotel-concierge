# =============================================================================
# Dockerfile.frontend — Next.js production image built from the REPO ROOT.
#   docker build -f Dockerfile.frontend -t hh-frontend .
# Same as frontend/Dockerfile but with COPY paths relative to the repo root,
# so Railway can build backend and frontend from one context using only
# RAILWAY_DOCKERFILE_PATH (no per-service root-directory override needed).
# NEXT_PUBLIC_* are injected at container start by the entrypoint (below),
# because Railway cannot pass Docker build args.
# =============================================================================
FROM node:20-alpine AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS deps
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --no-audit --no-fund

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
# Git cannot track the empty frontend/public/fonts dir, so recreate it here;
# the production stage COPYs /app/public unconditionally.
RUN mkdir -p public
RUN npm run build

FROM node:20-alpine AS production
RUN addgroup --gid 1001 nodejs && adduser --uid 1001 --ingroup nodejs --disabled-password nextjs
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Rewrite the localhost:8000 defaults baked into the client bundle at build time
# with the real public URLs supplied as container env vars.
RUN printf '#!/bin/sh\nif [ -n "$NEXT_PUBLIC_API_URL" ]; then\n  grep -rlF "http://localhost:8000" ./.next/static >/tmp/f 2>/dev/null || true\n  while IFS= read -r f; do sed -i "s#http://localhost:8000#$NEXT_PUBLIC_API_URL#g" "$f"; done < /tmp/f\nfi\nif [ -n "$NEXT_PUBLIC_WS_URL" ]; then\n  grep -rlF "ws://localhost:8000" ./.next/static >/tmp/f 2>/dev/null || true\n  while IFS= read -r f; do sed -i "s#ws://localhost:8000#$NEXT_PUBLIC_WS_URL#g" "$f"; done < /tmp/f\nfi\nexec node server.js\n' > /app/docker-entrypoint.sh && chmod +x /app/docker-entrypoint.sh

USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
ENTRYPOINT ["/app/docker-entrypoint.sh"]

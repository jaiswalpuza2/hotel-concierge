# =============================================================================
# Autonomous Multi-Agent Local Business Concierge — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Async SQLAlchemy connection URL (asyncpg driver)
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/hoteldb
# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# Generate a strong secret: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# LLM PROVIDER
# Supported: mock | openai | anthropic | ollama
#   mock       offline rule-based demo brain: no key, no cost, great for trying the
#              whole product (routing, tools, handoff, voice, UI). Not a real AI.
#   openai     LLM_MODEL=gpt-4o-mini (or any chat model your account can use)
#   anthropic  LLM_MODEL=claude-haiku-5-5 (cheap/fast) or claude-sonnet-5-5 (stronger)
#   ollama     local models, e.g. LLM_MODEL=llama3.1 (needs a model that supports tool calling)
# -----------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional: override base URL for Ollama or custom proxy
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# -----------------------------------------------------------------------------
# EMBEDDING MODEL
# Supported: sentence_transformer | openai | hashing
# sentence_transformer runs locally (no API key; first run downloads ~1 GB).
# hashing is a tiny offline embedder for quick demos/CI (lexical only, NOT semantic):
#   with it set RETRIEVAL_CONFIDENCE_THRESHOLD=0.25
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSIONS=768
# Used only if EMBEDDING_PROVIDER=openai (falls back to LLM_API_KEY when empty)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# RAG RETRIEVAL
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Cosine similarity needed to trust a chunk. Neural models: 0.30-0.45 works well; tune with real questions.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
MAX_RETRIEVAL_RETRIES=2
MAX_TOOL_RETRIES=2
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# -----------------------------------------------------------------------------
# SMS NOTIFICATIONS
# Supported: mock | sparrow
# mock: logs to tmp/mock_sms.log (use for local development)
# -----------------------------------------------------------------------------
SMS_PROVIDER=mock
SMS_SPARROW_TOKEN=CHANGE_ME
SMS_SPARROW_FROM=HimalHotel

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS
# Supported: mock | smtp
# mock: logs to tmp/mock_email.log (use for local development)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@himalayan-hotel.com

# -----------------------------------------------------------------------------
# HUMAN HANDOFF ALERTS
# Supported: mock | telegram | slack
# mock: logs to tmp/mock_handoff.log (use for local development)
# -----------------------------------------------------------------------------
HANDOFF_PROVIDER=mock
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# -----------------------------------------------------------------------------
# VOICE (STT / TTS)
# STT supported: whisper | google
# TTS supported: google | openai
# -----------------------------------------------------------------------------
STT_PROVIDER=whisper
TTS_PROVIDER=google
# Used if STT_PROVIDER=whisper (reuses LLM_API_KEY if same OpenAI account)
OPENAI_WHISPER_API_KEY=sk-CHANGE_ME
# Path to Google Cloud service account JSON (used for google STT/TTS)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_TTS_VOICE_NE=ne-NP-Standard-A
GOOGLE_TTS_VOICE_EN=en-US-Standard-D

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=json
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Maximum file upload size in bytes (20 MB)
MAX_FILE_UPLOAD_BYTES=20971520
# Sliding-window rate limit per IP per minute
RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# BUSINESS CONFIGURATION
# Change these to deploy for a different business type
# -----------------------------------------------------------------------------
BUSINESS_NAME=Himalayan Heritage Hotel
BUSINESS_TYPE=hotel
BUSINESS_LOCATION=Itahari, Sudurpurba Province, Nepal
KNOWLEDGE_BASE_PATH=knowledge_base/

# -----------------------------------------------------------------------------
# FRONTEND (Next.js public vars — safe to expose to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# -----------------------------------------------------------------------------
# AGENT / VOICE LIMITS
# -----------------------------------------------------------------------------
MAX_TOOL_ITERATIONS=6
HISTORY_WINDOW=14
MAX_AUDIO_BYTES=5242880
TTS_ENABLED=true
# Link shown to managers in Telegram/Slack handoff alerts
DASHBOARD_URL=http://localhost:3000/admin/handoffs
